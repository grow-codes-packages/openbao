{
  "name": "@grow-codes/openbao",
  "version": "0.1.2",
  "description": "Grow Codes SDK for OpenBao (TypeScript)",
  "keywords": [
    "openbao",
    "grow-codes",
    "sdk"
  ],
  "author": "Grow Codes <opensource@grow.codes>",
  "license": "Apache-2.0",
  "homepage": "https://grow-codes-packages.github.io/openbao/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grow-codes-packages/openbao.git",
    "directory": "typescript"
  },
  "bugs": {
    "url": "https://github.com/grow-codes-packages/openbao/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "sideEffects": false,
  "main": "./lib/index.cjs",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      },
      "require": {
        "types": "./lib/index.d.cts",
        "default": "./lib/index.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./lib/testing/index.d.ts",
        "default": "./lib/testing/index.js"
      },
      "require": {
        "types": "./lib/testing/index.d.cts",
        "default": "./lib/testing/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit && eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "coverage": "vitest run --coverage && node scripts/coverage-summary.mjs",
    "docs": "typedoc",
    "license": "node scripts/license-check.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "undici": "^7.30.2"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@opentelemetry/api": "^1.9.1",
    "@types/node": "^22.19.0",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "license-checker-rseidelsohn": "^5.0.1",
    "prettier": "^3.10.1",
    "tsup": "^9.0.0",
    "typedoc": "^0.28.20",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
